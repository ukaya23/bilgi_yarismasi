{
  "name": "bilgi-yarismasi",
  "version": "1.0.0",
  "description": "LAN Tabanlı Gerçek Zamanlı Bilgi Yarışması Sistemi",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:frontend": "node esbuild.config.mjs",
    "build:all": "npm run build && npm run build:frontend",
    "start": "node dist/server.js",
    "dev": "ts-node server.ts",
    "lint": "eslint src/ server.ts database/ --max-warnings 100",
    "lint:fix": "eslint src/ server.ts database/ --fix --max-warnings 100",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui"
  },
  "keywords": [
    "quiz",
    "websocket",
    "lan",
    "real-time"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.18.0",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.3",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
